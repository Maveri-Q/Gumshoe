+/*
+Get the browser location.hash, ignoring hashes that themselves start with a # (used for HTML anchor links)
+*/
+$tw.utils.getLocationHash = () => {
+	const hash = window.location.hash;
+	return hash === "" || /^#(?:#|%23)/.test(hash) ? "#" : hash;
+};
 
